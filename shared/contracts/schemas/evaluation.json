{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c1-agentic.local/schemas/evaluation.json",
  "title": "Evaluation",
  "type": "object",
  "required": [
    "correct",
    "understanding",
    "feedback",
    "estimated_mastery",
    "source_references"
  ],
  "properties": {
    "correct": { "type": "boolean" },
    "understanding": {
      "type": "string",
      "enum": ["strong", "partial", "misconception", "missing_prerequisite", "guessing"]
    },
    "feedback": { "type": "string" },
    "identified_misconception": { "type": ["string", "null"] },
    "estimated_mastery": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source-reference.json" }
    }
  },
  "additionalProperties": false
}
