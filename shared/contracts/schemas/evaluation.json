{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c1-agentic.local/schemas/evaluation.json",
  "title": "Evaluation",
  "type": "object",
  "required": [
    "correct",
    "understanding",
    "feedback",
    "estimated_mastery",
    "source_references"
  ],
  "properties": {
    "correct": { "type": "boolean" },
    "understanding": {
      "type": "string",
      "enum": ["strong", "partial", "misconception", "missing_prerequisite", "guessing"]
    },
    "feedback": { "type": "string" },
    "identified_misconception": { "type": ["string", "null"] },
    "estimated_mastery": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source-reference.json" }
    },
    "outcome": {
      "type": "string",
      "enum": ["correct", "partially_correct", "incorrect", "no_attempt"]
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "missing_elements": { "type": "array", "items": { "type": "string" } },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "description", "confidence", "evidence"],
        "properties": {
          "code": { "type": "string" },
          "description": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "string" },
          "related_prerequisite_id": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "mastery_delta": { "type": "number" },
    "rationale": { "type": "string" }
  },
  "additionalProperties": false
}
