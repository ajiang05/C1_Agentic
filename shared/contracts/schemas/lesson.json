{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c1-agentic.local/schemas/lesson.json",
  "title": "Lesson",
  "type": "object",
  "required": [
    "id",
    "concept_id",
    "course_id",
    "title",
    "teaching_content",
    "teaching_format",
    "question",
    "source_references"
  ],
  "properties": {
    "id": { "type": "string" },
    "concept_id": { "type": "string" },
    "course_id": { "type": "string" },
    "title": { "type": "string" },
    "teaching_content": { "type": "string" },
    "teaching_format": {
      "type": "string",
      "enum": ["explanation", "worked_example", "analogy", "visual", "step_by_step"]
    },
    "question": { "$ref": "lesson-question.json" },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source-reference.json" }
    },
    "tutor_action": { "type": ["string", "null"] },
    "guidance": { "type": ["string", "null"] },
    "next_step": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
