{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c1-agentic.local/schemas/lesson-question.json",
  "title": "LessonQuestion",
  "type": "object",
  "required": ["id", "prompt", "question_type", "difficulty", "source_references"],
  "properties": {
    "id": { "type": "string" },
    "prompt": { "type": "string" },
    "question_type": {
      "type": "string",
      "enum": ["multiple_choice", "true_false", "short_answer", "explain", "apply"]
    },
    "options": {
      "type": "array",
      "items": { "type": "string" }
    },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source-reference.json" }
    }
  },
  "additionalProperties": false
}
