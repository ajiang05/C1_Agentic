# Backend local env — copy to backend/.env

APP_NAME=Adaptive AI Study Journey
APP_VERSION=0.1.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (Auth + Postgres + Storage). Leave empty → in-memory demo persistence.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-materials

# OpenAI — agents fall back to demo stubs when missing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
